# Server port
PORT=5000

# Runtime
NODE_ENV=development

# MongoDB connection string
MONGO_URI=mongodb://localhost:27017/sea_ghotki

# JWT secrets — generate strong random values for production
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret

# Frontend URL (used for CORS and email links)
FRONTEND_URL=http://localhost:5173

# SMTP credentials for activation / notification emails (Nodemailer)
EMAIL_USER=you@example.com
EMAIL_PASSWORD=app-specific-password

# Google Drive folder ID for lecture files
GOOGLE_DRIVE_ROOT_FOLDER_ID=
